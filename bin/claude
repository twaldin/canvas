#!/bin/sh
# Chalkwork's claude wrapper: in a Chalkwork terminal tile, runs the real Claude Code with the Chalkwork
# plugin (extensions/claude: lifecycle, resume, follow mode, mentions, chalkwork skill) for this
# session only. Anywhere else, and with CHALKWORK_AGENT_HOOKS=0, it is the real claude, untouched.
here="$(cd "$(dirname "$0")/.." && pwd)"
. "$here/extensions/agent-hooks/wrap.sh"
real=$(canvas_agent_real claude) || exit 127
canvas_integrate || exec "$real" "$@"
export CHALKWORK_AGENT=claude
exec "$real" --plugin-dir "$here/extensions/claude" "$@"
