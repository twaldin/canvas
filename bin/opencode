#!/bin/sh
# Chalkwork's opencode wrapper: in a Chalkwork terminal tile, runs the real opencode with the Chalkwork plugin
# (extensions/opencode/chalkwork.ts, added through OPENCODE_CONFIG_CONTENT by
# extensions/opencode/config.ts) for this session only, and without its self-update. Anywhere else,
# and with CHALKWORK_AGENT_HOOKS=0, it is the real opencode, untouched.
here="$(cd "$(dirname "$0")/.." && pwd)"
. "$here/extensions/agent-hooks/wrap.sh"
real=$(canvas_agent_real opencode) || exit 127
canvas_env_restore OPENCODE_CONFIG_CONTENT
canvas_integrate || exec "$real" "$@"
config=$(bun "$here/extensions/opencode/config.ts" "${OPENCODE_CONFIG_CONTENT-}" 2>/dev/null) || exec "$real" "$@"
export CHALKWORK_AGENT=opencode OPENCODE_DISABLE_AUTOUPDATE=1
canvas_env_set OPENCODE_CONFIG_CONTENT "$config"
exec "$real" "$@"
