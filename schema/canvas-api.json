{
  "$comment": "Canvas API method catalog. Single source of truth for the socket protocol; clients (TS, Python, CLI) are generated from this file by scripts/gen-clients.ts. Bump `version` on any breaking change.",
  "version": 1,
  "transport": {
    "socket": "$CANVAS_SOCKET (default: ~/Library/Application Support/Canvas/canvas.sock)",
    "framing": "newline-delimited JSON, one object per line, UTF-8",
    "request": "{ id: string, method: string, params: object }",
    "response": "{ id: string, ok: true, result: any } | { id: string, ok: false, error: { code: string, message: string, data?: any } }",
    "events": "after a successful events.subscribe, the same connection receives { event: string, data: any } lines until closed"
  },
  "errors": {
    "invalid_params": "params failed schema validation",
    "not_found": "referenced object, mention, or agent does not exist",
    "conflict": "rev mismatch on update; re-read and retry",
    "unsupported": "method known but not implemented by this build",
    "unavailable": "target exists but cannot act right now (e.g. a terminal tile without an attached surface), or the app is not running",
    "timeout": "agent.wait deadline passed before the agent reached a requested state",
    "internal": "unexpected server failure"
  },
  "definitions": {
    "Id": { "type": "string", "pattern": "^[a-z]+_[0-9A-Za-z]+$", "description": "Prefixed id, e.g. obj_01H…, men_…" },
    "Frame": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" } },
      "additionalProperties": false
    },
    "Actor": {
      "oneOf": [
        { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "user" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["kind", "tile"],
          "properties": { "kind": { "const": "agent" }, "tile": { "$ref": "#/definitions/Id" }, "agent": { "type": "string" } },
          "additionalProperties": false
        }
      ]
    },
    "LineRange": {
      "type": "object",
      "required": ["start", "end"],
      "properties": { "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false,
      "description": "1-based inclusive line range"
    },
    "Lifecycle": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["working", "blocked", "idle", "done", "unknown"] },
        "message": { "type": "string" },
        "seen": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "TerminalProps": {
      "type": "object",
      "required": ["cwd", "command"],
      "properties": {
        "cwd": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" }, "description": "argv run inside the zmx session" },
        "zmxSession": { "type": "string" },
        "title": { "type": "string" },
        "agent": {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "type": "string" }, "sessionId": { "type": "string" }, "sessionPath": { "type": "string" } },
          "additionalProperties": false
        },
        "lifecycle": { "$ref": "#/definitions/Lifecycle" }
      },
      "additionalProperties": false
    },
    "BrowserProps": {
      "type": "object",
      "required": ["url"],
      "properties": { "url": { "type": "string" }, "title": { "type": "string" } },
      "additionalProperties": false
    },
    "CodeProps": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "description": "path relative to the board root" },
        "range": { "$ref": "#/definitions/LineRange" },
        "symbol": { "type": "string" },
        "mode": { "enum": ["diff", "source"], "default": "diff" },
        "diffBase": { "type": "string", "default": "merge-base", "description": "merge-base | head | <sha>" },
        "followOf": { "$ref": "#/definitions/Id", "description": "terminal tile this follow tile tracks" },
        "pinnedCommit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "NoteProps": {
      "type": "object",
      "required": ["markdown"],
      "properties": { "markdown": { "type": "string" } },
      "additionalProperties": false
    },
    "HtmlProps": {
      "type": "object",
      "required": ["html"],
      "properties": {
        "html": { "type": "string", "description": "page body (or a full document); the kit (Tailwind, Mermaid, canvas-code/link/decisions/compare) is preloaded" },
        "title": { "type": "string" },
        "allowNetwork": { "type": "array", "items": { "type": "string", "description": "host, host:port, or *.host; http/https/ws to anything else is blocked" }, "default": [] },
        "state": { "type": "object", "description": "tile state written by the page through its channel (e.g. canvas-decisions choices by key); at most 256 KiB" }
      },
      "additionalProperties": false
    },
    "ShapeProps": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["rect", "ellipse", "text", "ink"] },
        "text": { "type": "string" },
        "points": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3 }, "description": "ink points [x, y, pressure?] in object-local coordinates" },
        "color": { "type": "string", "description": "palette name (black, grey, blue, green, orange, red, violet) or #rrggbb" },
        "fill": { "enum": ["none", "semi", "solid"], "default": "none", "description": "rect/ellipse interior; only filled interiors hit-test, so an unfilled shape never blocks what is beneath it" }
      },
      "additionalProperties": false
    },
    "Binding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["object"],
          "properties": {
            "object": { "$ref": "#/definitions/Id" },
            "lines": { "$ref": "#/definitions/LineRange" },
            "selector": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["point"],
          "properties": { "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
          "additionalProperties": false
        }
      ]
    },
    "ArrowProps": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/definitions/Binding" },
        "to": { "$ref": "#/definitions/Binding" },
        "relation": { "type": "string", "description": "semantic edge type, e.g. hypothesis_about, calls, depends_on" },
        "label": { "type": "string" },
        "color": { "type": "string", "description": "palette name or #rrggbb, as ShapeProps.color" }
      },
      "additionalProperties": false
    },
    "GroupProps": {
      "type": "object",
      "required": ["members"],
      "properties": { "name": { "type": "string" }, "members": { "type": "array", "items": { "$ref": "#/definitions/Id" } } },
      "additionalProperties": false
    },
    "ObjectType": { "enum": ["terminal", "browser", "code", "note", "html", "shape", "arrow", "group"] },
    "CanvasObject": {
      "type": "object",
      "required": ["id", "type", "frame", "z", "rev", "createdBy", "createdAt", "updatedAt", "props"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "type": { "$ref": "#/definitions/ObjectType" },
        "frame": { "$ref": "#/definitions/Frame" },
        "z": { "type": "number" },
        "rev": { "type": "integer", "minimum": 1 },
        "parent": { "$ref": "#/definitions/Id" },
        "createdBy": { "$ref": "#/definitions/Actor" },
        "updatedBy": { "$ref": "#/definitions/Actor" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "props": { "type": "object", "description": "one of TerminalProps | BrowserProps | CodeProps | NoteProps | HtmlProps | ShapeProps | ArrowProps | GroupProps, selected by type" }
      },
      "additionalProperties": false
    },
    "MentionTarget": {
      "oneOf": [
        { "type": "object", "required": ["kind", "object"], "properties": { "kind": { "const": "object" }, "object": { "$ref": "#/definitions/Id" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["kind", "object", "path", "lines"],
          "properties": {
            "kind": { "const": "code" },
            "object": { "$ref": "#/definitions/Id" },
            "path": { "type": "string" },
            "lines": { "$ref": "#/definitions/LineRange" },
            "side": { "enum": ["old", "new"], "default": "new" },
            "symbol": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "object", "url", "selector"],
          "properties": {
            "kind": { "const": "dom" },
            "object": { "$ref": "#/definitions/Id" },
            "url": { "type": "string" },
            "selector": { "type": "string" },
            "text": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "object", "text"],
          "properties": {
            "kind": { "const": "terminal" },
            "object": { "$ref": "#/definitions/Id" },
            "text": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "objects"],
          "properties": { "kind": { "const": "group" }, "objects": { "type": "array", "items": { "$ref": "#/definitions/Id" } }, "name": { "type": "string" } },
          "additionalProperties": false
        }
      ]
    },
    "Mention": {
      "type": "object",
      "required": ["id", "target", "label", "stagedAt", "edited"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "target": { "$ref": "#/definitions/MentionTarget" },
        "label": { "type": "string" },
        "stagedAt": { "type": "string", "format": "date-time" },
        "edited": { "type": "boolean", "description": "target changed since staging" }
      },
      "additionalProperties": false
    },
    "ResolvedMention": {
      "type": "object",
      "required": ["id", "ref", "label", "summary"],
      "properties": {
        "id": { "$ref": "#/definitions/Id", "description": "mention id, for tray.commit" },
        "ref": { "type": "string", "description": "stable reference, e.g. canvas:men_12@rev3" },
        "label": { "type": "string" },
        "summary": { "type": "string", "description": "compact text for prompt context: location, excerpt, relations" },
        "graph": { "type": "object", "description": "structured view: contents, encloses, overlaps, arrows" }
      },
      "additionalProperties": false
    },
    "Agent": {
      "type": "object",
      "required": ["tile", "kind", "lifecycle"],
      "properties": {
        "tile": { "$ref": "#/definitions/Id" },
        "board": { "$ref": "#/definitions/Id" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "sessionId": { "type": "string" },
        "lifecycle": { "$ref": "#/definitions/Lifecycle" }
      },
      "additionalProperties": false
    },
    "BoardInfo": {
      "type": "object",
      "required": ["board", "root", "archived", "open", "objects"],
      "properties": {
        "board": { "$ref": "#/definitions/Id" },
        "root": { "type": "string", "description": "root directory the board was last opened at" },
        "archived": { "type": "boolean", "description": "the root directory no longer exists (e.g. a deleted worktree); the board is kept" },
        "open": { "type": "boolean", "description": "the board has a window in the app (only open boards accept `board` params)" },
        "updatedAt": { "type": "string", "description": "ISO 8601 time the board was last saved; absent for a board never saved" },
        "objects": { "type": "integer", "description": "object count" }
      },
      "additionalProperties": false
    }
  },
  "methods": {
    "system.ping": {
      "description": "Liveness and schema version.",
      "params": { "type": "object", "properties": {}, "additionalProperties": false },
      "result": { "type": "object", "required": ["version"], "properties": { "version": { "type": "integer" }, "app": { "type": "string" } } }
    },
    "board.get": {
      "description": "Board manifest: all objects (props summarized for heavy types) plus a change cursor. Objects created or changed since `since` are flagged.",
      "params": {
        "type": "object",
        "properties": { "board": { "$ref": "#/definitions/Id" }, "since": { "type": "integer", "description": "board revision cursor from a previous call" } },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["board", "root", "revision", "objects"],
        "properties": {
          "board": { "$ref": "#/definitions/Id" },
          "root": { "type": "string" },
          "revision": { "type": "integer" },
          "objects": { "type": "array", "items": { "$ref": "#/definitions/CanvasObject" } },
          "changed": { "type": "array", "items": { "$ref": "#/definitions/Id" } }
        }
      }
    },
    "board.list": {
      "description": "Every stored board, open or not, including archived boards whose root directory is gone.",
      "params": { "type": "object", "properties": {}, "additionalProperties": false },
      "result": { "type": "object", "required": ["boards"], "properties": { "boards": { "type": "array", "items": { "$ref": "#/definitions/BoardInfo" } } } }
    },
    "board.export": {
      "description": "Write a pretty-printed JSON snapshot of an open board (objects, frames, props; not the personal selection tray) into the repo. Committing it is left to the caller.",
      "params": {
        "type": "object",
        "properties": {
          "board": { "$ref": "#/definitions/Id" },
          "path": { "type": "string", "description": "absolute, or relative to the board root; default .canvas/board.json" }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["path", "objects"],
        "properties": { "path": { "type": "string", "description": "absolute path written" }, "objects": { "type": "integer" } }
      }
    },
    "object.get": {
      "description": "Read one object. `as: graph` adds structural relations: encloses, enclosedBy, overlaps, arrowsIn/arrowsOut (arrows bound to it), arrows (arrows drawn inside it, with from/to bindings), and from/to for an arrow; `as: image` returns a PNG crop as base64 (a tile's content, or the canvas region under a drawn object including the tiles and ink inside it).",
      "params": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "$ref": "#/definitions/Id" }, "as": { "enum": ["raw", "graph", "image"], "default": "raw" } },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["object"],
        "properties": { "object": { "$ref": "#/definitions/CanvasObject" }, "graph": { "type": "object" }, "pngBase64": { "type": "string" } }
      }
    },
    "object.create": {
      "description": "Create an object. Omit `frame` to let the canvas place it next to the calling agent's terminal (or the viewport center for users). The caller's tile (CANVAS_TILE_ID) becomes createdBy.",
      "params": {
        "type": "object",
        "required": ["type", "props"],
        "properties": {
          "board": { "$ref": "#/definitions/Id" },
          "type": { "$ref": "#/definitions/ObjectType" },
          "props": { "type": "object" },
          "frame": { "$ref": "#/definitions/Frame" },
          "parent": { "$ref": "#/definitions/Id" },
          "caller": { "$ref": "#/definitions/Id", "description": "calling tile id; clients fill from CANVAS_TILE_ID" }
        },
        "additionalProperties": false
      },
      "result": { "type": "object", "required": ["object"], "properties": { "object": { "$ref": "#/definitions/CanvasObject" } } }
    },
    "object.update": {
      "description": "Patch an object's frame and/or props (shallow merge). Pass `rev` for optimistic concurrency.",
      "params": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/definitions/Id" },
          "rev": { "type": "integer" },
          "frame": { "$ref": "#/definitions/Frame" },
          "props": { "type": "object" },
          "caller": { "$ref": "#/definitions/Id" }
        },
        "additionalProperties": false
      },
      "result": { "type": "object", "required": ["object"], "properties": { "object": { "$ref": "#/definitions/CanvasObject" } } }
    },
    "object.delete": {
      "description": "Delete an object (and remove it from any staged mentions). Arrows bound to it keep their drawn route: that end becomes a free `point` where it last attached.",
      "params": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "$ref": "#/definitions/Id" }, "caller": { "$ref": "#/definitions/Id" } },
        "additionalProperties": false
      },
      "result": { "type": "object", "properties": {} }
    },
    "tray.list": {
      "description": "Staged mentions, in staging order.",
      "params": { "type": "object", "properties": { "board": { "$ref": "#/definitions/Id" } }, "additionalProperties": false },
      "result": { "type": "object", "required": ["mentions"], "properties": { "mentions": { "type": "array", "items": { "$ref": "#/definitions/Mention" } } } }
    },
    "tray.stage": {
      "description": "Stage a mention (normally done by the user with Hyper-click; exposed for tests and agents).",
      "params": {
        "type": "object",
        "required": ["target"],
        "properties": { "target": { "$ref": "#/definitions/MentionTarget" }, "board": { "$ref": "#/definitions/Id" } },
        "additionalProperties": false
      },
      "result": { "type": "object", "required": ["mention"], "properties": { "mention": { "$ref": "#/definitions/Mention" } } }
    },
    "tray.unstage": {
      "description": "Remove one staged mention.",
      "params": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/definitions/Id" } }, "additionalProperties": false },
      "result": { "type": "object", "properties": {} }
    },
    "tray.drain": {
      "description": "Resolve all staged mentions at their current revision and return them with a ready-to-inject context block. By default the tray is cleared; with `peek: true` it is left intact so the caller can `tray.commit` exactly these ids once the context has really been delivered (a cancelled prompt then loses nothing).",
      "params": {
        "type": "object",
        "properties": {
          "board": { "$ref": "#/definitions/Id" },
          "caller": { "$ref": "#/definitions/Id" },
          "peek": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["mentions", "context"],
        "properties": {
          "mentions": { "type": "array", "items": { "$ref": "#/definitions/ResolvedMention" } },
          "context": { "type": "string", "description": "ready-to-inject prompt context block; empty string when the tray was empty" }
        }
      }
    },
    "tray.commit": {
      "description": "Remove exactly these mentions from the tray after their context was delivered (second half of a `peek` drain). Unknown ids are ignored.",
      "params": {
        "type": "object",
        "required": ["ids"],
        "properties": { "board": { "$ref": "#/definitions/Id" }, "ids": { "type": "array", "items": { "$ref": "#/definitions/Id" } } },
        "additionalProperties": false
      },
      "result": { "type": "object", "properties": {} }
    },
    "agent.report": {
      "description": "Report lifecycle state for the agent running in a terminal tile. Stale `seq` values from the same source are ignored.",
      "params": {
        "type": "object",
        "required": ["tile", "kind", "state"],
        "properties": {
          "tile": { "$ref": "#/definitions/Id" },
          "kind": { "type": "string" },
          "state": { "enum": ["working", "blocked", "idle", "unknown"] },
          "message": { "type": "string" },
          "seq": { "type": "integer" },
          "source": { "type": "string" }
        },
        "additionalProperties": false
      },
      "result": { "type": "object", "properties": {} }
    },
    "agent.report_session": {
      "description": "Report the agent's native session identity so the tile can resume it after a reboot.",
      "params": {
        "type": "object",
        "required": ["tile", "kind"],
        "properties": {
          "tile": { "$ref": "#/definitions/Id" },
          "kind": { "type": "string" },
          "sessionId": { "type": "string" },
          "sessionPath": { "type": "string" }
        },
        "additionalProperties": false
      },
      "result": { "type": "object", "properties": {} }
    },
    "agent.release": {
      "description": "The agent in this tile exited; clear its lifecycle authority.",
      "params": {
        "type": "object",
        "required": ["tile", "kind"],
        "properties": { "tile": { "$ref": "#/definitions/Id" }, "kind": { "type": "string" }, "source": { "type": "string" } },
        "additionalProperties": false
      },
      "result": { "type": "object", "properties": {} }
    },
    "agent.list": {
      "description": "Agents across all open boards.",
      "params": { "type": "object", "properties": {}, "additionalProperties": false },
      "result": { "type": "object", "required": ["agents"], "properties": { "agents": { "type": "array", "items": { "$ref": "#/definitions/Agent" } } } }
    },
    "agent.prompt": {
      "description": "Paste a prompt into another agent's terminal (bracketed paste) and press Enter. Rejected with `conflict` if that agent is blocked.",
      "params": {
        "type": "object",
        "required": ["target", "text"],
        "properties": { "target": { "type": "string", "description": "agent name or tile id" }, "text": { "type": "string" } },
        "additionalProperties": false
      },
      "result": { "type": "object", "required": ["agent"], "properties": { "agent": { "$ref": "#/definitions/Agent" } } }
    },
    "agent.wait": {
      "description": "Wait until the target agent reaches one of the given states.",
      "params": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": { "type": "string" },
          "until": { "type": "array", "items": { "enum": ["working", "blocked", "idle", "done", "unknown"] }, "default": ["idle", "done", "blocked"] },
          "timeoutMs": { "type": "integer" }
        },
        "additionalProperties": false
      },
      "result": { "type": "object", "required": ["agent"], "properties": { "agent": { "$ref": "#/definitions/Agent" } } }
    },
    "agent.read": {
      "description": "Recent text of an agent's terminal: the tail of its zmx session scrollback as plain text (what the screen shows plus history), trailing blank lines removed.",
      "params": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": { "type": "string", "description": "agent name or tile id" },
          "lines": { "type": "integer", "minimum": 1, "maximum": 2000, "default": 100, "description": "tail length; larger values are capped at 2000" }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": ["agent", "text", "lines"],
        "properties": {
          "agent": { "$ref": "#/definitions/Agent" },
          "text": { "type": "string" },
          "lines": { "type": "integer", "description": "number of lines returned" }
        }
      }
    },
    "follow.report": {
      "description": "Report a file location an agent just read or edited; re-aims that terminal's follow tile.",
      "params": {
        "type": "object",
        "required": ["tile", "path", "action"],
        "properties": {
          "tile": { "$ref": "#/definitions/Id" },
          "path": { "type": "string", "description": "absolute path or path relative to the board root" },
          "range": { "$ref": "#/definitions/LineRange" },
          "action": { "enum": ["read", "edit", "lsp", "search"] }
        },
        "additionalProperties": false
      },
      "result": { "type": "object", "properties": {} }
    },
    "view.attention": {
      "description": "Raise an attention marker pointing at an object. Never moves the user's viewport.",
      "params": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "$ref": "#/definitions/Id" }, "message": { "type": "string" } },
        "additionalProperties": false
      },
      "result": { "type": "object", "properties": {} }
    },
    "view.snapshot": {
      "description": "PNG of the board's window as the user sees it right now (viewport, tiles, tray). Terminal tiles are drawn from their session text.",
      "params": {
        "type": "object",
        "properties": { "board": { "$ref": "#/definitions/Id" } },
        "additionalProperties": false
